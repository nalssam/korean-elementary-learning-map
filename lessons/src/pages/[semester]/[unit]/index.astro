---
// 단원 페이지 (/<학기>/<단원>/, R45). 학기 페이지와 같은 목차를 곁에 두고,
// 머리(단원명, 교과서 쪽수, 차시 수, N/M 차시 공개, 접힌 성취기준) → 단원 자료 → 묶음 목록 → 앞뒤 단원 차례로 그린다.
// 단원 자료는 단원 정리 묶음(role: review)이 이번 빌드에 실릴 때 그 묶음의 카드·학습지다. 명세에 없는 단원 자료를 만들어 내지 않는다 (docs/CONTRACT.md 6절).
import { catalog, lessonRoute, lessonsLabel, loadRegistry, pagesLabel, semesterLabel, standardSummary, unitPages, unitProgress } from '#lib/content.ts';
import SiteLayout from '#src/layouts/SiteLayout.astro';
import { href } from '#src/lib/url.ts';
import BookFrame from '#src/components/site/BookFrame.astro';
import Fold from '#src/components/site/Fold.astro';
import ProgressBar from '#src/components/site/ProgressBar.astro';
import UnitBundles from '#src/components/site/UnitBundles.astro';
import Kicker from '#src/components/site/ui/Kicker.astro';
import ResourceCard from '#src/components/site/ui/ResourceCard.astro';
import { progressText, semesterRows } from '#src/components/site/book.ts';
import { textbookLabel } from '#src/components/site/data.ts';
import { standardCode } from '#src/components/site/format.ts';

export function getStaticPaths() {
  return loadRegistry().semesters.flatMap((s) => s.units.map((u) => ({ params: { semester: s.id, unit: String(u.no) } })));
}
const { semester: semesterId, unit: unitNo } = Astro.params;
const units = loadRegistry().semesters.find((s) => s.id === semesterId)?.units ?? [];
const unit = units.find((u) => String(u.no) === unitNo);
if (!unit) throw new Error(`차시표에 ${semesterId} 학기 ${unitNo}단원이 없습니다`);
const rows = semesterRows(semesterId).filter((r) => r.ref.unit.no === unit.no);
const semester = semesterLabel(semesterId);
const progress = unitProgress(semesterId, unit.no);

// 단원 자료: 단원 정리 묶음의 카드와 학습지. 그 묶음이 이번 빌드에 실릴 때만 건다.
const review = rows.find((r) => r.ref.role === 'review' && r.lesson);
const unitItems = review?.lesson ? catalog().filter((i) => i.lessonId === review.ref.id && (i.kind === 'cards' || i.kind === 'worksheet')) : [];

// 앞뒤 단원
const prevUnit = units.find((u) => u.no === unit.no - 1);
const nextUnit = units.find((u) => u.no === unit.no + 1);
---
<SiteLayout
  title={`${unit.no}단원 ${unit.title} · ${semester}`}
  crumbs={[{ label: '처음', href: href('/') }, { label: semester, href: href(`/${semesterId}/`) }, { label: `${unit.no}단원` }]}
>
  <BookFrame semester={semesterId} unit={unit.no} where={`${unit.no}단원`}>
    <header class="book-head">
      <Kicker>{semester} · {unit.no}단원</Kicker>
      <h1 class="page-title">{unit.title}</h1>
      <p class="book-textbook">{textbookLabel()} {pagesLabel(unitPages(unit))} · {progress.total}차시</p>
      <ProgressBar progress={progress} label={progressText(progress)} />
      <div class="book-standards">
        <Fold title="성취기준" count={`${unit.standards.length}개`}>
          <dl class="standards">
            {unit.standards.map((code) => <div><dt>{standardCode(code)}</dt><dd>{standardSummary(code)}</dd></div>)}
          </dl>
          <p class="fine" data-pagefind-ignore>코드 옆의 글은 줄여 쓴 요약이고, 교육부가 고시한 문장과 다릅니다.</p>
        </Fold>
      </div>
    </header>

    {review?.lesson && unitItems.length > 0 && (
      <section class="sec" aria-labelledby="unit-kit-title">
        <h2 class="sec-title" id="unit-kit-title">단원 자료</h2>
        <p class="sec-note">
          {lessonsLabel(review.ref.lessons)} <a href={href(lessonRoute(review.lesson.id))}>{review.lesson.title}</a>에서 쓰는 자료입니다.
        </p>
        <ul class="book-cards">
          {unitItems.map((item) => <li><ResourceCard item={item} /></li>)}
        </ul>
      </section>
    )}

    <section class="sec" aria-labelledby="lessons-title">
      <h2 class="sec-title" id="lessons-title">차시</h2>
      <UnitBundles rows={rows} />
    </section>

    {(prevUnit || nextUnit) && (
      <nav class="pager" aria-label="앞뒤 단원" data-pagefind-ignore>
        {prevUnit
          ? <a class="pager-link" href={href(`/${semesterId}/${prevUnit.no}/`)}><span class="pager-dir">앞 단원</span><span class="pager-name">{prevUnit.no}단원 {prevUnit.title}</span></a>
          : <span class="pager-gap"></span>}
        {nextUnit
          ? <a class="pager-link pager-next" href={href(`/${semesterId}/${nextUnit.no}/`)}><span class="pager-dir">다음 단원</span><span class="pager-name">{nextUnit.no}단원 {nextUnit.title}</span></a>
          : <span class="pager-gap"></span>}
      </nav>
    )}
  </BookFrame>
</SiteLayout>
