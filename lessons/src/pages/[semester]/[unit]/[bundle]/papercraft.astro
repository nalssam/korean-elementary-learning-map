---
// 페이퍼크래프트 인쇄 페이지 (docs/CONTRACT.md 7절 '페이퍼크래프트').
// 앞쪽들: 전개도 모듈(generators/papercraft/modules/<module>.ts)이 그린 190 × 249mm SVG 를 한 쪽에 하나씩 싣는다.
// 마지막 쪽: 명세의 steps·try_it·reflect 로 만드는 '만드는 법'. 모듈이 그림(preview)을 내놓으면 함께 싣는다.
// 그림의 이름(무슨 모습인지)은 모듈이 그림 안에 적는다. 그림이 여럿이어도 SVG 는 한 장이다.
// 실제 크기(100%)로 찍혀야 조각이 서로 맞는다. 인쇄 틀(PrintLayout, Sheet)은 그대로 쓴다.
import PrintLayout from '#src/components/print/PrintLayout.astro';
import Sheet from '#src/components/print/Sheet.astro';
import { lessonPaths, loadLesson, printJobs, sheetFooter } from '#lib/content.ts';
import { footReserve } from '#src/components/print/layout.ts';
import { keepParticle } from '#lib/site.ts';
import { textWidth } from '../../../../../generators/papercraft/net.ts';

export function getStaticPaths() { return lessonPaths('papercraft'); }

/** 전개도 모듈의 꼴. sheets 는 계약(7절)이 정한 것이고, preview 는 이 페이지가 더 받는 선택 내보내기다. */
interface PapercraftModule {
  sheets(texts: string[]): { title: string; sub: string; svg: string }[];
  /** 만드는 법 쪽의 그림 SVG (viewBox 를 가진 한 장, 그림의 이름까지 담는다). 없으면 그림을 싣지 않는다. */
  preview?(): string;
}

// 모듈은 빌드할 때 한꺼번에 읽어 둔다 (명세가 이름으로 고른다)
const modules = import.meta.glob<{ default: PapercraftModule }>('/generators/papercraft/modules/*.ts', { eager: true });

const lesson = loadLesson(Astro.props.id);
const job = printJobs(lesson).find((j) => j.kind === 'papercraft')!;
const pc = lesson.assets.papercraft;
if (pc.state !== 'ready') throw new Error(`${lesson.id}: 페이퍼크래프트가 ready 가 아닌데 페이지를 만들려 합니다`);
const mod = modules[`/generators/papercraft/modules/${pc.module}.ts`]?.default;
if (!mod) throw new Error(`${lesson.id}: 전개도 모듈 generators/papercraft/modules/${pc.module}.ts 가 없습니다 (assets.papercraft.module 을 확인합니다)`);
const sheets = mod.sheets(pc.texts);
if (sheets.length + 1 !== job.pages) {
  throw new Error(`${lesson.id}: 전개도 ${sheets.length}쪽과 만드는 법 1쪽을 합해 ${sheets.length + 1}쪽인데 명세의 assets.papercraft.pages 는 ${job.pages} 입니다. pages 를 고칩니다 (맞는 값: ${sheets.length + 1})`);
}
const preview = mod.preview?.();

// 반·이름 칸: 학생마다 뽑으면 이름, 모둠이나 짝이 함께 쓰면 모둠 이름, 학급에 한 부면 없음
const name = job.print.per === 'student' ? 'student' : job.print.per === 'class' ? 'none' : 'group';
const materials = job.print.materials;
// 그림 칸의 높이. 그림은 칸에 맞춰 줄어드므로, 그림 안의 가장 작은 글이 9pt(3.175mm) 아래로 줄지 않는 높이를 아래 끝으로 둔다.
// 칸의 안쪽 폭은 본문 190mm 에서 안쪽 여백(4mm × 2)과 테두리를 뺀 181.4mm 이다. 폭에 다 맞춘 높이를 위 끝으로 둔다 (그보다 높으면 빈자리만 남는다).
const FIG_W = 181.4, FIG_PAD = 6.2, PT9 = 3.175;
let fig: { min: number; max: number } | undefined;
if (preview) {
  const vb = preview.match(/viewBox="([^"]+)"/)?.[1].split(/\s+/).map(Number);
  const sizes = [...preview.matchAll(/font-size="([\d.]+)"/g)].map((m) => Number(m[1]));
  if (!vb || vb.length !== 4) throw new Error(`${lesson.id}: 전개도 모듈의 preview() 에 viewBox 가 없습니다`);
  const [, , vw, vh] = vb;
  const full = FIG_W / vw;
  const need = sizes.length ? PT9 / Math.min(...sizes) : 0;
  if (need > full + 1e-9) throw new Error(`${lesson.id}: 그림의 가장 작은 글(${Math.min(...sizes)})이 칸 폭에 다 맞춰도 9pt 가 되지 않습니다. 모듈에서 글을 키웁니다`);
  fig = { min: vh * need + FIG_PAD, max: vh * full + FIG_PAD };
}
// 생각해 보기의 쓰는 줄 수. 한 쪽(249mm)에 글을 다 싣고도 그림이 제 아래 끝 높이를 지키는 만큼만 준다 (3줄까지).
// 글의 높이는 어림이다. 줄 수는 전개도의 글 폭 어림(textWidth)으로 센다. 그 어림은 도안의 칸을 넘지 않으려고 넉넉하게 잡은 것이라,
// 본문 글(HTML)에는 0.92 를 곱해 쓴다 (Chromium 에서 잰 값은 어림의 0.89 안팎).
// 보통: 13pt 줄 높이 6.6mm, 12pt 6.3mm, 덩이 사이 5mm. 글이 많아 한 줄도 못 주면 '촘촘하게'(pc-tight)로 바꾼다:
// 글자 크기는 그대로(지시문 13pt, 본문 12pt, 7절) 두고 줄 사이와 덩이 사이만 줄인다 (6.2mm, 5.9mm, 3.5mm).
const rows = (s: string, size: number, width: number) => Math.max(1, Math.ceil((textWidth(s, size) * 0.92) / width));
const block = (head: number, items: string[], h: (s: string) => number, gap: number) => (items.length ? head + items.reduce((t, s) => t + h(s), 0) + gap * (items.length - 1) : 0);
const textH = (lines: number, tight: boolean) => [
  7.5,
  block(8, pc.steps, (s) => rows(s, 4.59, 180) * (tight ? 6.2 : 6.6), tight ? 1.2 : 2.2),
  block(8, pc.try_it, (s) => rows(s, 4.23, 185) * (tight ? 5.9 : 6.3), tight ? 0.8 : 1.5),
  block(8, pc.reflect, (s) => rows(s, 4.23, 190) * (tight ? 5.9 : 6.3) + lines * 10, tight ? 2 : 3),
].filter((h) => h > 0).reduce((t, h) => t + h + (tight ? 3.5 : 5), 0);
// 바닥글 앞의 틈(6mm, R29)을 남기려고 만드는 법 덩이 아래에 비워 두는 높이 (.pc-guide 의 padding-bottom)
const reserve = footReserve(`${sheetFooter(lesson)} · ${job.pages}/${job.pages}`);
const room = 247 - reserve - (fig ? fig.min : 0);
const tight = textH(1, false) > room;
const writeLines = [3, 2, 1].find((n) => textH(n, tight) <= room) ?? 1;
const over = textH(1, tight) - room;
if (over > 10) {
  throw new Error(`${lesson.id}: 페이퍼크래프트 만드는 법 쪽에 글이 너무 많습니다 (어림으로 ${Math.round(over)}mm 넘칩니다). assets.papercraft 의 steps·try_it·reflect 를 줄입니다`);
}
const kp = keepParticle;
---
<PrintLayout lesson={lesson} job={job}>
  {sheets.map((s, i) => (
    <Sheet lesson={lesson} job={job} no={i + 1} title={s.title} sub={s.sub} name={name}>
      <Fragment set:html={s.svg} />
    </Sheet>
  ))}
  <Sheet lesson={lesson} job={job} no={job.pages} title={pc.title} sub="만드는 법" name={name}>
    <div class:list={['pc-guide', { 'pc-tight': tight }]} style={`--foot-reserve:${reserve}mm`}>
      <p class="pc-need">
        <span class="pc-tag">준비물</span>
        <span>{[job.print.paper, ...materials].join(', ')}</span>
      </p>

      <span class="pc-gap" aria-hidden="true"></span>
      <section class="pc-steps" aria-labelledby="pc-steps-title">
        <h2 id="pc-steps-title">만드는 순서</h2>
        <ol>{pc.steps.map((step) => <li>{kp(step)}</li>)}</ol>
      </section>

      {preview && fig && <Fragment><span class="pc-gap" aria-hidden="true"></span></Fragment>}
      {preview && fig && (
        <figure class="pc-preview" style={`min-height:${fig.min.toFixed(1)}mm;max-height:${fig.max.toFixed(1)}mm`}>
          <div class="pc-preview-art" set:html={preview} />
        </figure>
      )}

      {pc.try_it.length > 0 && <Fragment><span class="pc-gap" aria-hidden="true"></span></Fragment>}
      {pc.try_it.length > 0 && (
        <section class="pc-try" aria-labelledby="pc-try-title">
          <h2 id="pc-try-title">해 보기</h2>
          <ul>{pc.try_it.map((t) => <li>{kp(t)}</li>)}</ul>
        </section>
      )}

      {pc.reflect.length > 0 && <Fragment><span class="pc-gap" aria-hidden="true"></span></Fragment>}
      {pc.reflect.length > 0 && (
        <section class="pc-reflect" aria-labelledby="pc-reflect-title">
          <h2 id="pc-reflect-title">생각해 보기</h2>
          <ol class:list={{ 'pc-numbered': pc.reflect.length > 1 }}>
            {pc.reflect.map((q) => (
              <li>
                <p>{kp(q)}</p>
                {Array.from({ length: writeLines }, () => <span class="pc-line" aria-hidden="true"></span>)}
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>
  </Sheet>
</PrintLayout>

<style is:global>
  /* 만드는 법 쪽. 본문(190 × 249mm)을 세로로 나눈다: 글은 제 높이만 쓰고, 완성 모습 그림이 남는 높이를 쓴다.
     흑백으로 뽑아도 읽히게 색 대신 굵기와 테두리로 나눈다. 지시문 13pt, 본문 12pt 이상, 쓰는 줄 간격 10mm (7절). */
  .pc-guide { display: flex; flex-direction: column; box-sizing: border-box; height: 100%; padding-bottom: var(--foot-reserve, 0mm); color: var(--ink); }
  /* 덩이 사이: 5mm 에서 남는 높이를 나눠 10mm 까지 벌린다. 그래도 남으면 쪽 아래에 남긴다 (덩이가 쪽 위아래로 흩어지지 않게). */
  .pc-gap { flex: 1 1 0; min-height: 5mm; max-height: 10mm; }
  .pc-guide h2 { margin: 0 0 2mm; font-size: 13pt; font-weight: 700; line-height: 1.3; }
  .pc-guide ol, .pc-guide ul { margin: 0; padding: 0; list-style: none; }

  .pc-need { flex: none; display: flex; align-items: baseline; gap: 3mm; margin: 0; font-size: 12pt; line-height: 1.45; }
  .pc-tag { flex: none; padding: 0.4mm 2.2mm; border: 0.3mm solid var(--ink); border-radius: 1.2mm; font-size: 11pt; font-weight: 700; }

  .pc-steps { flex: none; }
  .pc-steps ol { counter-reset: pc-step; display: grid; gap: 2.2mm; }
  .pc-steps li { counter-increment: pc-step; position: relative; padding-left: 10mm; font-size: 13pt; line-height: 1.45; }
  .pc-steps li::before {
    content: counter(pc-step); position: absolute; left: 0; top: 0.2mm;
    width: 6.6mm; height: 6.6mm; border: 0.35mm solid var(--ink); border-radius: 50%;
    display: grid; place-items: center; font-size: 11pt; font-weight: 700; line-height: 1;
  }

  /* 그림 칸: 남는 높이를 쓰되, 위아래 끝은 페이지가 그림의 글 크기로 정한다 (위 frontmatter 의 fig). */
  .pc-preview { flex: 1 1 0; display: flex; flex-direction: column; margin: 0; padding: 2.8mm 4mm; border: 0.3mm solid var(--rule-soft); border-radius: 2mm; }
  .pc-preview-art { flex: 1 1 0; min-height: 0; }
  .pc-preview-art svg { max-height: 100%; }

  .pc-try, .pc-reflect { flex: none; }
  /* 해 보기의 칸: 모둠이 해 본 것을 연필로 표시하는 4.4mm 네모. 글머리표로 읽히지 않게 크게, 가는 선으로 그리고
     첫 줄의 가운데에 맞춘다 (줄 높이 6.35mm(12pt 의 1.5배)에서 칸 높이를 빼고 반으로 나눈 0.975mm). */
  .pc-try li { position: relative; padding-left: 8mm; font-size: 12pt; line-height: 1.5; }
  .pc-try li::before {
    content: ''; position: absolute; left: 0; top: 0.975mm; box-sizing: border-box;
    width: 4.4mm; height: 4.4mm; border: 0.25mm solid var(--ink); border-radius: 0.6mm;
  }
  .pc-try li + li { margin-top: 2mm; }

  .pc-reflect ol { counter-reset: pc-q; display: grid; gap: 3mm; }
  .pc-reflect li { counter-increment: pc-q; }
  .pc-reflect p { margin: 0; font-size: 12pt; line-height: 1.5; }
  .pc-reflect .pc-numbered p::before { content: counter(pc-q) '. '; font-weight: 700; }
  .pc-line { display: block; height: 10mm; border-bottom: 0.3mm solid var(--rule); }

  /* 촘촘하게: 글이 많을 때. 글자 크기는 그대로, 줄 사이와 덩이 사이만 줄인다. */
  .pc-tight .pc-gap { min-height: 3.5mm; }
  .pc-tight h2 { margin-bottom: 1.5mm; }
  .pc-tight .pc-steps ol { gap: 1.2mm; }
  .pc-tight .pc-steps li { line-height: 1.35; }
  .pc-tight .pc-steps li::before { top: -0.1mm; }
  .pc-tight .pc-try li, .pc-tight .pc-reflect p { line-height: 1.38; }
  .pc-tight .pc-try li::before { top: 0.72mm; }
  .pc-tight .pc-try li + li { margin-top: 0.8mm; }
  .pc-tight .pc-reflect ol { gap: 2mm; }
</style>
