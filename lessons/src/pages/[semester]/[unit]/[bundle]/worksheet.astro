---
// 학습지 인쇄 페이지 (/<id>/worksheet/). 명세의 worksheet.pages 한 묶음이 종이 한 쪽이다.
// 첫 쪽 머리에 반·번호·이름 칸이 들어가고, 번호는 쪽이 바뀌어도 이어 센다 (docs/CONTRACT.md 7절).
// 본문 아래에는 바닥글과의 틈(6mm, R29)을 남긴다. 쓰는 칸이 남는 높이를 나누어 가져도 이 틈은 남는다.
// 블록이 한 쪽에 다 들어가지 않으면 render-pdf 가 어느 쪽 몇째 블록부터 넘치는지 알리고 빌드를 멈춘다.
import PrintLayout from '#src/components/print/PrintLayout.astro';
import Sheet from '#src/components/print/Sheet.astro';
import WorksheetBlocks from '#src/components/print/WorksheetBlocks.astro';
import '#src/components/print/worksheet.css';
import { footReserve, placeWorksheet } from '#src/components/print/layout.ts';
import { lessonPaths, loadLesson, printJobs, sheetFooter } from '#lib/content.ts';
import { keepParticle as k } from '#lib/site.ts';

export function getStaticPaths() { return lessonPaths(); }
const lesson = loadLesson(Astro.props.id);
const job = printJobs(lesson).find((j) => j.kind === 'worksheet')!;
const worksheet = lesson.worksheet;
const pages = placeWorksheet(lesson);
const width = job.print.orientation === 'landscape' ? 277 : 190;
// 바닥글 앞의 틈(6mm)을 남기려고 본문 아래에 비워 두는 높이 (worksheet.css 의 .ws padding-bottom)
const reserve = footReserve(`${sheetFooter(lesson)} · ${job.pages}/${job.pages}`, width);
---
<PrintLayout lesson={lesson} job={job}>
  {pages.map((page, i) => (
    <Sheet lesson={lesson} job={job} no={i + 1} title={k(worksheet.title)} sub={worksheet.subtitle && k(worksheet.subtitle)} name={i === 0 ? 'student' : 'none'}>
      <div class="ws" style={`--foot-reserve:${reserve}mm`}>
        {page.heading && <h2 class="ws-heading">{k(page.heading)}</h2>}
        <WorksheetBlocks lesson={lesson} items={page.items} width={width} />
      </div>
    </Sheet>
  ))}
  {/* 그림 줄의 단 폭과 그림 높이 (R34). 쪽 밖(.ws 밖)에 둔다: 쪽 안에 두면 블록으로 세어진다. */}
  <script>
    // 그림 줄의 단 폭과 그림 높이 (R34). 단은 그 설명이 한 줄에 들어가는 폭보다 좁지 않고, 줄 폭의 절반을 넘지 않는다.
    // 그 안에서 모든 그림이 같은 높이로 그려지도록 가장 큰 공통 높이를 찾는다 (R15):
    //   단 i 의 폭 = max(그림의 가로세로 비 × 높이, 설명 한 줄의 폭),  단 폭의 합 + 틈 ≤ 줄 폭,  높이 ≤ --fig-h,  그림 폭 ≤ 줄 폭의 절반.
    // 설명이 줄 폭의 절반에도 한 줄로 들지 않으면 절반 폭에서 고르게 접힌다 (worksheet.css 의 text-wrap: balance).
    // 남는 폭은 단마다 똑같이 나눈다 (절반을 넘지 않게). 그림은 단 안에 contain 으로 아래 가운데에 선다.
    // 재는 값은 모두 화면에 그려진 크기(getBoundingClientRect)로 견주고, 적는 값은 그 비율로 바꾼다. 화면 미리보기의 배율이 달라도 맞는다.
    // 인쇄 페이지에서만 일하고, 끝나면 사진 테두리(Base.astro)를 다시 잰다. 스크립트가 돌지 않으면 그림의 가로세로 비로 나눈 꼴이 남는다.
    function layoutRow(row: HTMLElement) {
      const cells = [...row.querySelectorAll<HTMLElement>(':scope > .ws-figcell')];
      const n = cells.length;
      if (n < 2) return;
      row.style.removeProperty('--fig-fit');
      const box = row.getBoundingClientRect();
      if (!box.width || !row.clientWidth) return;
      const scale = box.width / row.clientWidth; // 그려진 px / 상자 안의 px
      const W = box.width;
      const gap = (Number.parseFloat(getComputedStyle(row).columnGap) || 0) * scale;
      const room = W - gap * (n - 1);
      const half = W / 2;
      // 그림 높이의 윗한계: --fig-h (쪽에 따라 다르다)
      const probe = document.createElement('div');
      probe.style.cssText = 'position:absolute;visibility:hidden;width:0;height:var(--fig-h)';
      row.append(probe);
      const cap = probe.getBoundingClientRect().height;
      probe.remove();
      const ratios = cells.map((cell) => Number(cell.dataset.ratio) || 1);
      // 설명 한 줄의 폭 (빈칸에서 줄이 바뀌지 않게 하고 잰다)
      let captions = cells.map((cell) => {
        const p = cell.querySelector<HTMLElement>('.ws-fig-caption');
        if (!p || !p.textContent?.trim()) return 0;
        const before = p.style.whiteSpace;
        p.style.whiteSpace = 'nowrap';
        const r = document.createRange();
        r.selectNodeContents(p);
        const w = r.getBoundingClientRect().width;
        p.style.whiteSpace = before;
        return Math.min(half, Math.ceil(w) + 2 * scale);
      });
      // 설명들만으로도 줄이 모자라면 설명이 접히도록 비례해 줄인다
      const sumCaptions = captions.reduce((a, b) => a + b, 0);
      if (sumCaptions > room) captions = captions.map((c) => (c * room) / sumCaptions);
      const need = (h: number) => ratios.reduce((sum, r, i) => sum + Math.max(r * h, captions[i]), 0);
      let lo = 0;
      let hi = Math.min(cap, ...ratios.map((r) => half / r));
      if (need(hi) > room) {
        for (let k = 0; k < 40; k++) {
          const mid = (lo + hi) / 2;
          if (need(mid) <= room) lo = mid; else hi = mid;
        }
        hi = lo;
      }
      const h = hi;
      const widths = ratios.map((r, i) => Math.max(r * h, captions[i]));
      // 남는 폭을 단마다 똑같이 나눈다 (절반을 넘는 단은 절반에서 멈추고 나머지가 받는다)
      let left = room - widths.reduce((a, b) => a + b, 0);
      for (let round = 0; round < n && left > 0.5; round++) {
        const open = widths.map((w, i) => (w < half - 0.01 ? i : -1)).filter((i) => i >= 0);
        if (!open.length) break;
        const share = left / open.length;
        for (const i of open) {
          const add = Math.min(share, half - widths[i]);
          widths[i] += add;
          left -= add;
        }
      }
      // 폭을 fr 로 적는다. fr 의 합이 1 보다 작으면 남는 폭의 그만큼만 나누므로 그려진 px 그대로 적는다 (합은 늘 1 보다 크다).
      row.style.gridTemplateColumns = widths.map((w) => `minmax(0,${w.toFixed(3)}fr)`).join(' ');
      row.style.setProperty('--fig-fit', `${(h / scale).toFixed(2)}px`);
    }
    function layoutAll() {
      if (document.body.dataset.kind !== 'print') return;
      for (const row of document.querySelectorAll<HTMLElement>('.ws-figrow')) layoutRow(row);
      window.dispatchEvent(new Event('media-layout'));
    }
    layoutAll();
    document.fonts.ready.then(layoutAll);
    window.addEventListener('load', layoutAll);
    window.addEventListener('beforeprint', layoutAll);
  </script>
</PrintLayout>
