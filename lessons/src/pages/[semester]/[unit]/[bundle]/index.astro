---
// 차시 안내 페이지 (/<id>/). 교사가 수업 전에 한 번 읽고, 수업 중에 버튼을 누르는 페이지다.
// 차례: 차시·쪽수·성취기준·검수 상태 → 큰 버튼 → 준비물 → 수업 흐름 → 확인 퀴즈·웹 활동(QR) → 더 해 볼 자료 → 접어 둔 교사용 자료.
// 명세에 없는 내용을 여기에 적지 않는다. 다음 차시의 명세만 넣으면 같은 페이지가 나온다 (docs/CONTRACT.md 4절).
import { bundleOf, lessonPaths, lessonRoute, lessonsLabel, loadLesson, semesterLabel } from '#lib/content.ts';
import type { Lesson } from '#schema/lesson.ts';
import SiteLayout from '#src/layouts/SiteLayout.astro';
import { href } from '#src/lib/url.ts';
import KitActions from '#src/components/site/KitActions.astro';
import KitFlow from '#src/components/site/KitFlow.astro';
import KitHead from '#src/components/site/KitHead.astro';
import KitMore from '#src/components/site/KitMore.astro';
import KitPrepare from '#src/components/site/KitPrepare.astro';
import KitStudent from '#src/components/site/KitStudent.astro';
import KitTeacher from '#src/components/site/KitTeacher.astro';
import { neighbours } from '#src/components/site/data.ts';

export function getStaticPaths() { return lessonPaths(); }
// props 로는 id 만 받고 여기에서 읽는다. astro dev 에서 명세를 고치면 바로 바뀐다.
const lesson: Lesson = loadLesson(Astro.props.id);
const ref = bundleOf(lesson);
const semester = semesterLabel(ref.semester.id);
const { prev, next } = neighbours(lesson.id);
const crumbs = [
  { label: '처음', href: href('/') },
  { label: semester, href: href(`/${ref.semester.id}/`) },
  { label: `${ref.unit.no}단원 ${ref.unit.title}`, href: href(`/${ref.semester.id}/${ref.unit.no}/`) },
  { label: lessonsLabel(ref.lessons) },
];
---
<SiteLayout title={`${lesson.title} · ${semester} ${ref.unit.no}단원 ${lessonsLabel(ref.lessons)}`} description={lesson.tagline} lesson={lesson} crumbs={crumbs}>
  <article class="kit">
    <KitHead lesson={lesson} />
    <KitActions lesson={lesson} />
    <KitPrepare lesson={lesson} />
    <KitFlow lesson={lesson} />
    <KitStudent lesson={lesson} />
    <KitMore lesson={lesson} />
    <KitTeacher lesson={lesson} />
  </article>
  {(prev?.lesson || next?.lesson) && (
  <nav class="pager" aria-label="앞뒤 차시" data-pagefind-ignore>
    {prev?.lesson
      ? <a class="pager-link" href={href(lessonRoute(prev.lesson.id))}><span class="pager-dir">앞 차시</span><span class="pager-name">{lessonsLabel(prev.ref.lessons)} {prev.lesson.title}</span></a>
      : <span></span>}
    {next?.lesson
      ? <a class="pager-link pager-next" href={href(lessonRoute(next.lesson.id))}><span class="pager-dir">다음 차시</span><span class="pager-name">{lessonsLabel(next.ref.lessons)} {next.lesson.title}</span></a>
      : <span></span>}
  </nav>
  )}
  <p class="kit-report" data-pagefind-ignore>틀린 곳이나 고칠 곳을 찾으면 <a href={`${href('/report/')}?id=${lesson.id}`}>오류 제보</a>로 알려 주세요.</p>
</SiteLayout>
