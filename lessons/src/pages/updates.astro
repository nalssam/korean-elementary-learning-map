---
// 업데이트 소식 (/updates/, R49). content/updates.yaml 의 소식 가운데 이번 빌드에 보여 줄 것(visibleUpdates()), 날짜가 늦은 것부터.
// 차시를 가리키는 소식은 그 차시가 실릴 때만 나온다. 미리 보기 빌드에서 초안을 가리키는 소식에는 '초안' 표를 붙인다.
// 달마다 묶는다. 소식이 늘어도 한 달 치가 한눈에 들어온다.
import { courseLine, visibleUpdates } from '#lib/content.ts';
import type { VisibleUpdate } from '#lib/content.ts';
import SiteLayout from '#src/layouts/SiteLayout.astro';
import { href } from '#src/lib/url.ts';
import CatHead from '#src/components/site/catalog/CatHead.astro';
import StatusChip from '#src/components/site/ui/StatusChip.astro';
import '#src/components/site/catalog/catalog.css';

const updates = visibleUpdates();
const months: { key: string; label: string; items: VisibleUpdate[] }[] = [];
for (const u of updates) {
  const [y, m] = u.date.split('-');
  const key = `${y}-${m}`;
  if (months.at(-1)?.key !== key) months.push({ key, label: `${y}년 ${Number(m)}월`, items: [] });
  months.at(-1)!.items.push(u);
}
// 첫 화면의 '최근 올라온 자료'와 같은 꼴: 2026. 11. 21.
const dateLabel = (d: string) => d.split('-').map(Number).join('. ') + '.';
---
<SiteLayout title="업데이트" description="새로 올린 차시와 고친 곳을 날짜순으로 알립니다." current="updates">
  <CatHead kicker="새 소식" title="업데이트">새로 올린 차시와 고친 곳을 적습니다. 최근 소식이 맨 위에 옵니다.</CatHead>

  {months.length === 0 && <p class="up-empty">아직 올린 소식이 없습니다.</p>}
  {months.map((m) => (
    <section class="up-month" aria-labelledby={`up-${m.key}`}>
      <h2 class="up-month-title" id={`up-${m.key}`}>{m.label}</h2>
      <ol class="up-list">
        {m.items.map((u) => (
          <li class="up-item" data-kind={u.kind}>
            <p class="up-meta">
              <time class="up-date" datetime={u.date}>{dateLabel(u.date)}</time>
              <StatusChip state={u.kind} />
              {u.draft && <StatusChip state="draft" />}
            </p>
            <div class="up-main">
              <h3 class="up-title">{u.title}</h3>
              {u.body && <p class="up-body">{u.body}</p>}
              {u.links.length > 0 && (
                <ul class="up-links">
                  {u.links.map((l) => (
                    <li>
                      <a class="up-link" href={href(l.route)}>
                        <span class="up-link-course">{courseLine(l.id)}</span>
                        <span class="up-link-title">{l.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</SiteLayout>
