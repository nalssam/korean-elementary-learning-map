---
// 모든 페이지의 <html>. 계약 파일.
// 글꼴과 디자인 기준값을 여기 한 곳에서만 싣고, 검색 로봇 표시와 맨 아래 문구(AI 사용 표시·초안 표시)를 여기에서만 정한다.
// 담당마다 만드는 틀(SiteLayout, PrintLayout, Stage, StudentLayout)은 모두 이 파일을 감싼다.
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/tokens.css';
import { footerNotice, isPublic, showDrafts } from '#lib/content.ts';
import { SITE } from '#lib/site.ts';
import type { Lesson } from '#schema/lesson.ts';

interface Props {
  /** <title> 앞부분. 뒤에 사이트 이름이 붙는다. */
  title: string;
  description?: string;
  /** site: 사이트 화면 · print: 인쇄 페이지 · stage: 수업 화면 · student: 학생 페이지(퀴즈·웹 활동) */
  kind: 'site' | 'print' | 'stage' | 'student';
  /** 차시에 딸린 페이지이면 그 차시. 초안인지 보고 맨 아래 문구를 고른다. */
  lesson?: Lesson;
}
const { title, description = SITE.tagline, kind, lesson } = Astro.props;
const draft = lesson ? !isPublic(lesson) : false;
// 미리 보기 빌드(SHOW_DRAFTS=1)는 통째로 검색에서 뺀다. 공개 빌드에서는 사이트 화면만 검색에 나온다.
// 초안의 페이지는 어느 빌드에서든 검색에 내놓지 않는다 (lessonPaths() 를 쓰지 않은 페이지가 초안을 공개 빌드에 섞어 넣는 실수가 있어도).
const robots = showDrafts() || draft ? 'noindex,nofollow' : kind === 'site' ? undefined : 'noindex';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {SITE.name}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <slot name="head" />
  </head>
  <body data-kind={kind} data-draft={draft ? 'true' : undefined}>
    <slot />
    {(kind === 'site' || kind === 'student') && <p class="site-notice">{footerNotice(lesson)}</p>}
    <script>
      // 인쇄 페이지에서 사진 테두리의 자리를 잰다 (Media.astro 의 @media print). 그려진 그림의 자리는 상자 크기, 그림의 가로세로, object-position 으로 정해진다.
      // 값은 상자에 대한 백분율로 적어, 화면 미리보기와 인쇄의 배율이 달라도 그대로 맞는다.
      // 모든 페이지에 실리지만 인쇄 페이지(data-kind="print")에서만 일한다. 조건으로 감싼 <script> 는 Astro 가 처리하지 않는다.
      // 스크립트가 돌지 않으면 바탕 사각형의 크기가 0 이라 테두리가 없을 뿐 그림은 그대로 찍힌다.
      function placeFrame(img: HTMLImageElement) {
        const W = img.clientWidth, H = img.clientHeight; // 안쪽 여백을 포함한 상자 (테두리 없음)
        if (!img.naturalWidth || !W || !H) return;
        const t = Number.parseFloat(getComputedStyle(img).paddingTop) || 0;
        // 인쇄에서 쓰는 여백(0.5pt = 2/3px)으로 잰다. 화면에서 잴 때는 여백이 0 이므로 같은 비율로 맞춘다.
        const pad = t || 2 / 3;
        const cw = W - 2 * pad, ch = H - 2 * pad;
        const k = Math.min(cw / img.naturalWidth, ch / img.naturalHeight);
        const dw = img.naturalWidth * k, dh = img.naturalHeight * k;
        const [px, py] = getComputedStyle(img).objectPosition.split(' ').map((v) => (v.endsWith('%') ? Number.parseFloat(v) / 100 : 0.5));
        const fw = dw + 2 * pad, fh = dh + 2 * pad;
        img.style.setProperty('--frame-size', `${(fw / W) * 100}% ${(fh / H) * 100}%`);
        // background-position 의 백분율은 '남는 자리의 몇 %' 다. 그림이 남는 자리에서 놓인 비율(object-position)과 같다.
        img.style.setProperty('--frame-pos', `${px * 100}% ${py * 100}%`);
      }
      function placeAll() {
        if (document.body.dataset.kind !== 'print') return;
        for (const img of document.querySelectorAll<HTMLImageElement>(".media[data-frame='photo'] img")) {
          if (img.complete) placeFrame(img);
          else img.addEventListener('load', () => placeFrame(img), { once: true });
        }
      }
      placeAll();
      window.addEventListener('beforeprint', placeAll);
      window.addEventListener('resize', placeAll);
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; font-family: var(--font); font-size: var(--fs-md); line-height: var(--lh); color: var(--navy); background: var(--bg); word-break: keep-all; overflow-wrap: anywhere; }
  h1, h2, h3 { line-height: var(--lh-tight); text-wrap: balance; }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .site-notice { margin: var(--s6) auto var(--s5); padding: 0 var(--s4); max-width: var(--content); font-size: var(--fs-xs); color: var(--gray); }
  /* 그림은 자르지 않는다 (이용 조건이 변경을 금지한 사진이 있다). 틀에 맞출 때는 contain 으로 줄인다. */
  .media { margin: 0; }
  .media img { display: block; max-width: 100%; height: auto; object-fit: contain; }
  .media figcaption { display: flex; flex-wrap: wrap; gap: 0 var(--s2); font-size: var(--fs-xs); color: var(--gray); }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; scroll-behavior: auto !important; } }
</style>
