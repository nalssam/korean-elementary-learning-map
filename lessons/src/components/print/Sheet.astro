---
// 인쇄물 한 쪽. docs/CONTRACT.md 7절의 꼴(.sheet > .sheet-head + .sheet-body + .sheet-foot)을 내놓는다.
// 학습지·카드·컬러링·페이퍼크래프트 페이지가 모두 이것으로 쪽을 만든다.
// 뼈대는 계약과 함께 들어왔고 인쇄물 담당이 이어서 채운다. props 와 class 이름·치수는 바꾸지 않는다 (페이퍼크래프트 담당이 같이 기대고 있다).
// 머리(.sheet-head)는 22mm 로 고정이다. title·sub·이름 칸이 그 안에 들어가야 한다. 넘친 글은 본문 위에 겹쳐 찍히고, render-pdf 가 빌드를 멈춘다 (7절 조건 2).
import { sheetFooter } from '#lib/content.ts';
import type { PrintJob } from '#lib/content.ts';
import type { Lesson } from '#schema/lesson.ts';

interface Props {
  lesson: Lesson;
  /** printJobs(lesson) 가운데 이 페이지의 것. 방향과 전체 쪽수를 여기에서 얻는다. */
  job: PrintJob;
  /** 몇째 쪽인가 (1부터) */
  no: number;
  title: string;
  sub?: string;
  /** 반·이름 칸. student: 반·번호·이름 · group: 모둠 이름 · none: 없음 */
  name?: 'student' | 'group' | 'none';
}
const { lesson, job, no, title, sub, name = 'none' } = Astro.props;
---
<section class="sheet" data-orientation={job.print.orientation}>
  <header class="sheet-head">
    <div class="sheet-title"><strong>{title}</strong>{sub && <span>{sub}</span>}</div>
    {name === 'student' && <div class="sheet-name">(&nbsp;&nbsp;&nbsp;)반 (&nbsp;&nbsp;&nbsp;)번 이름 (&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;)</div>}
    {name === 'group' && <div class="sheet-name">(&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;) 모둠</div>}
  </header>
  <div class="sheet-body"><slot /></div>
  <footer class="sheet-foot">{sheetFooter(lesson)} · {no}/{job.pages}</footer>
</section>
