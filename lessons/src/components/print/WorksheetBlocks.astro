---
// 학습지 블록들을 차례로 그린다. schema/lesson.ts 의 블록 종류마다 꼴이 하나씩 있다.
// 번호와 섞는 순서는 layout.ts 가 정해 준 값(Placed)을 그대로 쓴다. 여기에서는 그리기만 한다.
// data-part 는 render-pdf 가 넘친 자리를 알려 줄 때 읽는 이름이다 ("3번째 블록(줄 쓰기 칸)").
// 풀이(worksheetKey)는 찍지 않는다. 연표의 빈칸(blank)과 문항의 정답·풀이는 HTML 에도 싣지 않는다.
import Media from '#src/components/Media.astro';
import { getPassage } from '#lib/content.ts';
import type { Lesson } from '#schema/lesson.ts';
import { choiceColumns, frameParts, matchOrder, tableWeights } from './layout.ts';
import type { Placed } from './layout.ts';

interface Props {
  lesson: Lesson;
  items: Placed[];
}
const { lesson, items } = Astro.props;
const count = (n: number) => Array.from({ length: n }, (_, i) => i);
const percent = (weights: number[]) => { const sum = weights.reduce((a, b) => a + b, 0); return weights.map((w) => `width:${((w / sum) * 100).toFixed(2)}%`); };
---
{items.map((it) => {
  const b = it.block;
  switch (b.type) {
    case 'prompt':
      return (
        <p class="ws-block ws-prompt" data-part={it.where}>
          {it.no !== undefined && <span class="ws-no">{it.no}</span>}
          <span class="ws-prompt-text">{b.text}</span>
        </p>
      );
    case 'lines':
      return (
        <div class="ws-block ws-lines" data-part={it.where}>
          {b.label && <p class="ws-label">{b.label}</p>}
          {count(b.count).map(() => <div class="ws-rule"></div>)}
        </div>
      );
    case 'box':
      return (
        <div class="ws-block ws-box" data-part={it.where} style={`height:${b.height_mm}mm`}>
          {b.label && <p class="ws-label">{b.label}</p>}
        </div>
      );
    case 'figure':
      return (
        <div class="ws-block ws-figure" data-part={it.where} data-width={b.width}>
          <Media lesson={lesson} id={b.media} caption={b.show_caption} />
        </div>
      );
    case 'observe_infer':
      return (
        <div class="ws-block ws-oi" data-part={it.where}>
          <div class="ws-oi-in">
            {b.media && <Media lesson={lesson} id={b.media} caption={false} class="ws-oi-media" />}
            <div class="ws-oi-main">
              <p class="ws-oi-target">{b.target}</p>
              <div class="ws-oi-cols">
                {[b.observe_label, b.infer_label, b.reason_label].map((label) => (
                  <div class="ws-oi-col">
                    <p class="ws-oi-label">{label}</p>
                    <div class="ws-oi-lines">{count(b.lines).map(() => <div class="ws-rule"></div>)}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      );
    case 'table': {
      const widths = percent(tableWeights(b.columns, b.rows));
      return (
        <table class="ws-block ws-table" data-part={it.where}>
          <colgroup>{widths.map((w) => <col style={w} />)}</colgroup>
          <thead><tr>{b.columns.map((c) => <th scope="col">{c}</th>)}</tr></thead>
          <tbody>
            {b.rows.map((row) => <tr>{row.map((cell) => <td class:list={[cell === '' && 'ws-fill']}>{cell}</td>)}</tr>)}
          </tbody>
        </table>
      );
    }
    case 'match': {
      const order = matchOrder(lesson.id, it.key, b.pairs.length);
      return (
        <div class="ws-block ws-match" data-part={it.where}>
          {b.pairs.map((pair, i) => (
            <>
              <div class="ws-match-item ws-match-left"><span>{pair.left}</span><i class="ws-dot"></i></div>
              <div class="ws-match-item ws-match-right"><i class="ws-dot"></i><span>{b.pairs[order[i]].right}</span></div>
            </>
          ))}
        </div>
      );
    }
    case 'quiz':
      return (
        <div class="ws-block ws-quiz" data-part={it.where}>
          {b.items.map((n, i) => {
            const q = lesson.quiz.items[n - 1];
            return (
              <div class="ws-q" data-type={q.type}>
                <p class="ws-prompt">
                  <span class="ws-no">{it.quizNos?.[i]}</span>
                  <span class="ws-prompt-text">{q.q}</span>
                  {q.type === 'ox' && <span class="ws-ox"><span>O</span><span>X</span></span>}
                </p>
                {q.type === 'choice' && (
                  <ol class="ws-choices" data-columns={choiceColumns(q.choices)}>
                    {q.choices.map((c, ci) => <li><span class="ws-choice-no">{ci + 1}</span><span>{c}</span></li>)}
                  </ol>
                )}
                {q.type === 'short' && <div class="ws-answer"></div>}
              </div>
            );
          })}
        </div>
      );
    case 'sentence_frame':
      return (
        <p class="ws-block ws-frame" data-part={it.where}>
          {frameParts(b.frame).map((part) => part.kind === 'text'
            ? <span class="ws-frame-text">{part.text}</span>
            : part.kind === 'blank' ? <span class="ws-frame-blank"></span> : <span class="ws-frame-break"></span>)}
        </p>
      );
    case 'timeline':
      return (
        <ol class="ws-block ws-timeline" data-part={it.where}>
          {b.points.map((p) => (
            <li class:list={[p.blank && 'ws-timeline-blank']}>
              <span class="ws-timeline-when">{p.when}</span>
              <span class="ws-timeline-mark"></span>
              <span class="ws-timeline-what">{p.blank ? '' : p.what}</span>
            </li>
          ))}
        </ol>
      );
    case 'note':
      return (
        <div class="ws-block ws-note" data-part={it.where}>
          {b.title && <p class="ws-note-title">{b.title}</p>}
          {b.text.map((t) => <p>{t}</p>)}
          {b.source && <p class="ws-source">{b.source}</p>}
        </div>
      );
    case 'passage': {
      const passage = getPassage(lesson, b.passage);
      return (
        <article class="ws-block ws-passage" data-part={it.where}>
          <h3>{passage.title}</h3>
          {passage.text.map((t) => <p>{t}</p>)}
          <p class="ws-source">{passage.source}</p>
        </article>
      );
    }
    case 'columns':
      return (
        <div class="ws-block ws-columns" data-part={it.where} style={`grid-template-columns:repeat(${b.columns.length},minmax(0,1fr))`}>
          {(it.columns ?? []).map((col) => <div class="ws-col"><Astro.self lesson={lesson} items={col} /></div>)}
        </div>
      );
  }
})}
