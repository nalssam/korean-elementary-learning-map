---
// 사이트 페이지의 머리: 청록 머리말(Kicker), 큰 제목(ExtraBold), 한 줄 설명 (R53).
// 소개·이용 조건·오류 제보·404 가 쓴다. 다른 사이트 페이지도 같은 머리를 쓰면 페이지마다 첫인상이 같아진다.
//   <PageHead kicker="소개" title="…">한 줄 설명</PageHead>
import Kicker from './ui/Kicker.astro';

interface Props {
  /** 제목 위의 작은 청록 글씨. 이 페이지가 사이트의 어느 자리인지 */
  kicker?: string;
  title: string;
  /** 제목의 id (aria-labelledby 로 가리킬 때) */
  id?: string;
}
const { kicker, title, id } = Astro.props;
const lead = Astro.slots.has('default');
---
<header class="ph">
  {kicker && <Kicker>{kicker}</Kicker>}
  <h1 class="ph-title" id={id}>{title}</h1>
  {lead && <p class="ph-lead"><slot /></p>}
</header>

<style>
  .ph { display: grid; gap: var(--s1); max-width: 46rem; padding-top: var(--s2); }
  .ph-title { margin: 0; font-size: var(--fs-2xl); font-weight: var(--fw-heading); line-height: 1.25; letter-spacing: -0.03em; }
  .ph-lead { margin-top: var(--s2); font-size: var(--fs-lg); line-height: 1.55; color: var(--navy); }
  @media (max-width: 760px) {
    .ph { padding-top: 0; }
    .ph-title { font-size: calc(var(--fs-xl) * 1.08); }
    .ph-lead { font-size: var(--fs-md); line-height: var(--lh); }
  }
</style>
