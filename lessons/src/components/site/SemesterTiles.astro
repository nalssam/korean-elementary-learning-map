---
// 학년·학기 타일 여덟 개 (3-1 … 6-2, R43). 학기마다 따르는 교과서, "N/M 차시 공개", 진행 막대, 상태 표.
// 차시표가 있는 학기는 교과서 목차(/<학기>/)로 가고, 차시표가 아직 없는 학기는 링크 없이 '차시표 준비 중'이라고만 보여 준다.
// 학기 목록은 loadRegistry() 에서, 세는 것은 semesterProgress() 에서 얻는다 (차시를 센다. 두 차시 묶음은 2).
// 초안은 미리 보기 빌드에서만 센다 (공개 빌드에서는 draft 가 늘 0 이다).
import { loadRegistry, semesterLabel, semesterProgress } from '#lib/content.ts';
import { href } from '#src/lib/url.ts';
import StatusChip from './ui/StatusChip.astro';
import { textbookLabel } from './data.ts';

const book = textbookLabel();
const tiles = loadRegistry().semesters.map((s) => ({ id: s.id, label: semesterLabel(s.id), blurb: s.blurb, p: semesterProgress(s.id) }));
const pct = (n: number, total: number) => (total ? `${((100 * n) / total).toFixed(2)}%` : '0%');
---
<ul class="st-list">
  {tiles.map((t) => (
    <li>
      {t.p.total > 0 ? (
        <a class="st" href={href(`/${t.id}/`)}>
          <span class="st-top">
            <span class="st-name">{t.label}</span>
            {t.p.draft > 0 && <StatusChip state="draft" label={`초안 ${t.p.draft}차시`} />}
          </span>
          <span class="st-book">{book}</span>
          {t.blurb && <span class="st-blurb">{t.blurb}</span>}
          <span class="st-foot">
            <span class="st-count">{t.p.published}/{t.p.total} 차시 공개</span>
            <span class="st-bar" aria-hidden="true">
              <span class="st-bar-pub" style={`width:${pct(t.p.published, t.p.total)}`}></span><span class="st-bar-draft" style={`width:${pct(t.p.draft, t.p.total)}`}></span>
            </span>
          </span>
        </a>
      ) : (
        <div class="st is-off">
          <span class="st-top"><span class="st-name">{t.label}</span></span>
          <span class="st-book">{book}</span>
          <span class="st-foot"><span class="st-off">차시표 준비 중</span></span>
        </div>
      )}
    </li>
  ))}
</ul>

<style>
  /* 가로는 학년(3~6), 세로는 학기(1·2). 차례는 3-1, 3-2, 4-1 … 그대로이고 세로로 먼저 채운다. */
  .st-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: auto auto; grid-auto-flow: column; gap: var(--s4); }
  .st {
    display: flex; flex-direction: column; gap: var(--s1); height: 100%; padding: var(--s4) var(--s4) var(--s4);
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); color: var(--navy); text-decoration: none;
  }
  a.st:hover { border-color: var(--teal); }
  a.st:hover .st-name { color: var(--teal); }
  .st-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s1) var(--s2); }
  .st-name { font-size: var(--fs-lg); font-weight: 800; letter-spacing: -0.01em; }
  .st-book { font-size: var(--fs-xs); color: var(--gray); }
  .st-blurb { margin-top: var(--s2); font-size: var(--fs-sm); line-height: 1.5; color: var(--navy); }
  .st-foot { display: grid; gap: var(--s2); margin-top: auto; padding-top: var(--s4); }
  .st-count { font-size: var(--fs-sm); font-weight: 700; color: var(--teal); font-variant-numeric: tabular-nums; }
  /* 진행 막대: 공개는 청록, 초안(미리 보기에서만)은 옅은 청록. 그러데이션 없이 두 토막을 잇는다. */
  .st-bar { display: flex; height: 6px; border-radius: var(--radius-pill); background: var(--paper); overflow: hidden; }
  .st-bar-pub { background: var(--teal); }
  .st-bar-draft { background: color-mix(in srgb, var(--teal) 35%, var(--card)); }
  .st.is-off { border-style: dashed; background: none; }
  .st.is-off .st-name { color: var(--gray); }
  .st-off { font-size: var(--fs-sm); color: var(--gray); }

  @media (max-width: 760px) {
    .st-list { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; grid-auto-flow: row; gap: var(--s3); }
    .st { padding: var(--s3); }
    .st-name { font-size: var(--fs-md); }
    /* 두 칸 격자에서 소개 글이 있는 타일만 길어져 옆 타일이 비어 보이므로 휴대폰에서는 소개를 뺀다 (교과서 목차 페이지에 있다) */
    .st-blurb { display: none; }
    .st-foot { padding-top: var(--s3); }
  }
</style>
