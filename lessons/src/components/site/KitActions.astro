---
// 큰 버튼. '수업 화면 띄우기'와 '학습지 인쇄' 둘이 기본이고, 페이퍼크래프트가 ready 인 묶음에만 '만들기 인쇄'가 붙는다 (docs/CONTRACT.md 6절).
// 버튼 아래의 작은 링크는 만들어진 파일(PPTX, PDF)을 내려받는다. 경로와 한글 파일 이름은 pptxFile() 과 printJobs() 가 준다.
import { lessonRoute, pptxFile, printJobs } from '#lib/content.ts';
import { ASSET_LABEL, ASSET_ROUTE } from '#lib/site.ts';
import type { Lesson } from '#schema/lesson.ts';
import { href } from '#src/lib/url.ts';

interface Props { lesson: Lesson }
const { lesson } = Astro.props;
const pptx = pptxFile(lesson);
const jobs = printJobs(lesson);
const worksheet = jobs.find((j) => j.kind === 'worksheet');
const papercraft = jobs.find((j) => j.kind === 'papercraft');
---
<div class="actions" data-pagefind-ignore>
  <div class="action">
    <a class="btn btn-primary btn-big" href={href(lessonRoute(lesson.id, ASSET_ROUTE.slides))}>{ASSET_LABEL.slides} 띄우기</a>
    <a class="action-sub" href={href(pptx.file)} download={pptx.download}><span class="visually-hidden">{ASSET_LABEL.slides} </span>PPTX 내려받기</a>
  </div>
  {worksheet && (
    <div class="action">
      <a class="btn btn-big" href={href(worksheet.route)}>{worksheet.label} 인쇄</a>
      <a class="action-sub" href={href(worksheet.file)} download={worksheet.download}><span class="visually-hidden">{worksheet.label} </span>PDF 내려받기</a>
    </div>
  )}
  {papercraft && (
    <div class="action">
      <a class="btn btn-big" href={href(papercraft.route)}>만들기 인쇄</a>
      <a class="action-sub" href={href(papercraft.file)} download={papercraft.download}><span class="visually-hidden">{papercraft.label} </span>PDF 내려받기</a>
    </div>
  )}
</div>
