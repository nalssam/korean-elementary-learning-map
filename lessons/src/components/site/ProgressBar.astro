---
// "N/M 차시 공개"와 진행 막대 (교과서 목차·단원 페이지의 머리). 막대는 같은 값을 그림으로 보여 줄 뿐이라 화면 읽기 프로그램에는 숨긴다.
// 미리 보기 빌드에서는 초안의 차시를 막대에 옅게 잇고 '초안 N차시' 표를 붙인다 (공개 빌드에서는 draft 가 늘 0 이다).
import type { Progress } from '#lib/content.ts';
import { progressWidths } from './book.ts';
import StatusChip from './ui/StatusChip.astro';

interface Props {
  progress: Progress;
  /** "0/45 차시 공개" */
  label: string;
}
const { progress, label } = Astro.props;
const w = progressWidths(progress);
---
<div class="book-progress" data-pagefind-ignore>
  <p class="book-progress-text">
    <span class="book-progress-count">{label}</span>
    {progress.draft > 0 && <StatusChip state="draft" label={`초안 ${progress.draft}차시`} />}
  </p>
  <span class="book-progress-bar" aria-hidden="true">
    {w.published > 0 && <span class="book-progress-published" style={`width:${w.published.toFixed(2)}%`}></span>}
    {w.draft > 0 && <span class="book-progress-draft" style={`width:${w.draft.toFixed(2)}%`}></span>}
  </span>
</div>
