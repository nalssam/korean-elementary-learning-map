---
// 앞뒤 차시 (R46). 같은 학기 안에서 차시표 차례로 바로 앞과 뒤 묶음이다 (lessonNeighbours. 단원을 건너서도).
// 이번 빌드에 실리지 않는 이웃은 차시 번호와 '준비 중'만 보여 주고 링크를 걸지 않는다. 단원이 바뀌면 단원 번호를 앞에 붙인다.
import { lessonNeighbours, lessonRoute } from '#lib/content.ts';
import type { Neighbour } from '#lib/content.ts';
import { href } from '#src/lib/url.ts';

interface Props {
  id: string;
  /** 이 묶음의 단원 번호. 이웃이 다른 단원이면 "2단원 1차시"처럼 적는다. */
  unit: number;
}
const { id, unit } = Astro.props;
const { prev, next } = lessonNeighbours(id);
const sides = [
  { n: prev, dir: '앞 차시', cls: 'pager-prev' },
  { n: next, dir: '다음 차시', cls: 'pager-next' },
] as const;
const where = (n: Neighbour) => `${n.unit === unit ? '' : `${n.unit}단원 `}${n.lessonsLabel}`;
---
{(prev || next) && (
  <nav class="pager" aria-label="앞뒤 차시" data-pagefind-ignore>
    {sides.map(({ n, dir, cls }) => (
      !n ? <span class="pager-gap"></span>
      : n.ready ? (
        <a class:list={['pager-link', cls]} href={href(lessonRoute(n.id))}>
          <span class="pager-dir">{dir}</span>
          <span class="pager-name">{where(n)} {n.title}</span>
        </a>
      ) : (
        <p class:list={['pager-link', 'is-off', cls]}>
          <span class="pager-dir">{dir}</span>
          <span class="pager-name">{where(n)} · {n.pagesLabel} <span class="pager-later">준비 중</span></span>
        </p>
      )
    ))}
  </nav>
)}
