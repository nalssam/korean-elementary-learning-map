---
// 확인 퀴즈와 웹 활동: 아이들이 여는 페이지의 QR 과 링크. QR 은 이 페이지만 만든다 (docs/CONTRACT.md 6절).
// 주소는 absoluteUrl() 로 만든다. 종이와 화면에 박히는 주소라서 브라우저의 location 으로 만들지 않는다.
import { absoluteUrl, answerText, lessonRoute, quizByLesson, scored } from '#lib/content.ts';
import { ASSET_LABEL, ASSET_ROUTE } from '#lib/site.ts';
import type { Lesson } from '#schema/lesson.ts';
import { href } from '#src/lib/url.ts';
import { usedInFlow } from './data.ts';
import Fold from './Fold.astro';
import Qr from './Qr.astro';

interface Props { lesson: Lesson }
const { lesson } = Astro.props;
const quizRoute = lessonRoute(lesson.id, ASSET_ROUTE.quiz);
const web = lesson.assets.web_activity.state === 'ready' ? lesson.assets.web_activity : undefined;
const playRoute = lessonRoute(lesson.id, ASSET_ROUTE.web_activity);
const groups = quizByLesson(lesson).filter((g) => g.items.length > 0);
const multi = quizByLesson(lesson).length > 1;
const count = lesson.quiz.items.length;
const perLesson = multi ? groups.map((g) => `${g.lesson}차시 ${g.items.length}문항`).join(' · ') : '';
const webAside = web && !usedInFlow(lesson).has('web_activity');
---
<section class="sec" aria-labelledby="student-title">
  <h2 class="sec-title" id="student-title">{web ? `${ASSET_LABEL.quiz}와 ${ASSET_LABEL.web_activity}` : ASSET_LABEL.quiz}</h2>
  <p class="sec-note" data-pagefind-ignore>아이들이 QR 코드를 찍거나 주소를 넣어 엽니다. 이름을 묻지 않고, 답을 저장하거나 다른 곳으로 보내지 않습니다.{!scored(lesson) && ' 이 차시에서는 점수를 보여 주지 않습니다.'}</p>
  <div class="qr-cards">
    <article class="qr-card">
      <Qr url={absoluteUrl(quizRoute)} label={`${ASSET_LABEL.quiz} QR 코드`} />
      <div class="qr-text">
        <h3 class="qr-title">{ASSET_LABEL.quiz}</h3>
        <p class="qr-desc">{count}문항{perLesson && ` (${perLesson})`}</p>
        <p class="qr-url" data-pagefind-ignore>{absoluteUrl(quizRoute)}</p>
        <p class="qr-open" data-pagefind-ignore><a href={href(quizRoute)}>{ASSET_LABEL.quiz} 열기</a></p>
      </div>
    </article>
    {web && (
      <article class="qr-card">
        <Qr url={absoluteUrl(playRoute)} label={`${ASSET_LABEL.web_activity} QR 코드`} />
        <div class="qr-text">
          <h3 class="qr-title">{ASSET_LABEL.web_activity}</h3>
          {webAside && <p class="qr-tag" data-pagefind-ignore><span class="chip chip-plain">더 해 볼 자료</span></p>}
          <p class="qr-desc">{web.title}</p>
          <p class="qr-url" data-pagefind-ignore>{absoluteUrl(playRoute)}</p>
          <p class="qr-open" data-pagefind-ignore><a href={href(playRoute)}>{ASSET_LABEL.web_activity} 열기</a></p>
        </div>
      </article>
    )}
  </div>
  <div class="folds">
    <Fold title="문항과 정답" count={`${count}문항`}>
      {groups.map((g) => (
        <>
          {multi && <p class="fold-sub">{g.lesson}차시</p>}
          <ol class="quiz-items">
            {g.items.map(({ no, item }) => (
              <li value={no}>
                <p class="quiz-q">{item.q}</p>
                {item.type === 'choice' && <ol class="quiz-choices">{item.choices.map((c) => <li>{c}</li>)}</ol>}
                <p class="quiz-a"><strong>정답</strong> {answerText(item)}</p>
                <p class="quiz-why">{item.explain}</p>
              </li>
            ))}
          </ol>
        </>
      ))}
    </Fold>
  </div>
</section>
