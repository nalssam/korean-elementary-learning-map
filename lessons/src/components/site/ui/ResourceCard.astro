---
// 자료 카드 하나 (R47). 차시 자료실, 자료 유형별, 내 자료함이 같은 카드를 쓴다.
//   미리보기 틀(4:3, 종이색) · 자료 종류와 담기 · 자료 이름 · (차시) · 한 줄 설명 · 여는 단추 · 내려받기 · QR(학생 페이지)
// 넓은 화면에서는 위아래로 쌓고, 휴대폰(600px 아래)에서는 미리보기를 왼쪽에 작게 두어 카드 하나가 화면을 다 차지하지 않게 한다.
// 그래서 휴대폰에서는 카드 목록을 한 줄에 하나씩 놓는다 (격자는 부르는 페이지가 정한다).
// 값은 catalog() 의 한 줄(CatalogItem)에서만 얻는다. 명세를 따로 읽지 않는다.
// 미리보기 그림이 실리지 않으면(astro dev, 1단계만 돌린 dist) <img> 를 지워 뒤의 자료 그림이 보이게 한다.
// 담기 단추는 collect.ts 의 init() 이 저장소를 쓸 수 있을 때만 드러낸다 (스크립트가 돌지 않거나 저장소가 막혀 있으면 숨은 채로 둔다).
// QR 은 popover 로 연다: 스크립트 없이 열리고, Esc·바깥 누르기로 닫히고, 닫히면 초점이 QR 단추로 돌아온다. 창의 둘째 줄은 이 카드의 이름이다
// (교실 화면에 띄우는 창이라, 누른 카드와 같은 이름이어야 한다. 차시의 이름이 아니다).
// 담기 단추의 보이는 말은 담기 전 '담기', 담은 뒤 '담음'이다. 화면 읽기 프로그램에는 늘 '담기: <자료>'와 눌림 상태(aria-pressed)로 읽힌다.
// 함께 쓰는 컴포넌트다 (계약. docs/CONTRACT.md 6절). 카드의 뼈대를 바꿀 것이 있으면 계약 담당에게 알린다.
import { absoluteUrl, lessonRoute } from '#lib/content.ts';
import type { CatalogItem } from '#lib/content.ts';
import { KIND_GROUP, OPEN_LABEL } from '#lib/site.ts';
import { href } from '#src/lib/url.ts';
import Qr from '#src/components/Qr.astro';
import UrlText from '#src/components/UrlText.astro';
import StatusChip from './StatusChip.astro';
import TypeIcon from './TypeIcon.astro';

interface Props {
  item: CatalogItem;
  /** 차시의 학기·단원·차시와 이름을 함께 보여 줄지. 여러 차시의 자료를 늘어놓는 자료 유형별·내 자료함에서 켠다. 차시 자료실에서는 끈다. */
  withLesson?: boolean;
  /** 자료 이름의 머리말 수준. 기본 3 */
  level?: 2 | 3 | 4;
  /** 같은 페이지에 같은 자료의 카드를 두 번 그릴 때 QR 창의 id 가 겹치지 않게 붙이는 말 */
  uid?: string;
}
const { item, withLesson = false, level = 3, uid = '' } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3' | 'h4';
// 아이가 QR 로 여는 학생 페이지 (확인 퀴즈, 웹 활동)
const student = item.kind === 'quiz' || item.kind === 'web_activity';
const qrId = `qr-${item.key.replace(/[^a-z0-9]+/gi, '-')}${uid ? `-${uid}` : ''}`;
const qrUrl = student ? absoluteUrl(item.route) : '';
// 단추의 말("띄우기", "내려받기")만으로는 어느 자료인지 모른다. 화면 읽기 프로그램에는 자료 이름을 붙여 읽힌다.
const which = `${item.label} ${item.title}${withLesson ? ` (${item.course})` : ''}`;
---
<article class="rc" data-kind={item.kind} data-group={KIND_GROUP[item.kind]} data-key={item.key} data-draft={item.draft ? 'true' : undefined}>
  <div class="rc-frame">
    <TypeIcon kind={item.kind} size={44} class="rc-icon" />
    {item.thumb && (
      <img class="rc-thumb" src={href(item.thumb)} alt={`${item.label} 미리보기`} loading="lazy" decoding="async" onerror="this.remove()" />
    )}
  </div>
  <div class="rc-body">
    <div class="rc-head">
      <p class="rc-label"><TypeIcon kind={item.kind} size={16} />{item.label}</p>
      <button class="rc-collect" type="button" data-collect={item.key} aria-pressed="false" hidden>
        <svg class="rc-mark" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M7 4.5h10a1 1 0 0 1 1 1v14l-6-4-6 4v-14a1 1 0 0 1 1-1z" /></svg><span class="rc-collect-off" aria-hidden="true">담기</span><span class="rc-collect-on" aria-hidden="true">담음</span><span class="visually-hidden">담기: {which}</span>
      </button>
    </div>
    <Heading class="rc-title">{item.title}</Heading>
    {withLesson && (
      <p class="rc-lesson"><a href={href(lessonRoute(item.lessonId))}>{item.course} · {item.lessonTitle}</a></p>
    )}
    <p class="rc-format">{item.format}{item.draft && <>{' '}<StatusChip state="draft" /></>}</p>
  </div>
  <div class="rc-actions" data-pagefind-ignore>
    <a class="rc-open" href={href(item.route)}>{OPEN_LABEL[item.kind]}<span class="visually-hidden">: {which}</span></a>
    {item.file && (
      <a class="rc-btn" href={href(item.file.route)} download={item.file.name}>내려받기<span class="visually-hidden">: {which}</span></a>
    )}
    {student && (
      <button class="rc-btn rc-qr" type="button" popovertarget={qrId}>QR<span class="visually-hidden"> 코드 보기: {which}</span></button>
    )}
  </div>
  {student && (
    <div class="rc-pop" id={qrId} popover data-pagefind-ignore>
      <p class="rc-pop-title">{item.label}</p>
      <p class="rc-pop-sub">{item.title}</p>
      <Qr url={qrUrl} label={`${item.label} QR 코드`} />
      <p class="rc-pop-url"><UrlText url={qrUrl} /></p>
      <button class="rc-btn rc-pop-close" type="button" popovertarget={qrId} popovertargetaction="hide" autofocus>닫기</button>
    </div>
  )}
</article>

<script>
  import { init } from '../collect.ts';
  init();
</script>

<style is:global>
  /* 그림자 없이 1px 테두리의 납작한 흰 카드 (R53). 무게를 :where() 로 0 에 두어 페이지의 class 하나로 바꿀 수 있게 한다. */
  :where(.rc) { display: flex; flex-direction: column; min-width: 0; height: 100%; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); color: var(--navy); overflow: hidden; }

  /* 미리보기 틀: 4:3 종이색. 그림 뒤에 자료 종류의 선 그림이 있어, 미리보기 그림이 없거나(만들기 세트, astro dev) 실리지 않으면(onerror 가 <img> 를 지운다) 선 그림이 보인다.
     그림은 자르지 않고 틀 안에 들어가는 만큼 줄인다. 1px 테두리는 그려진 그림의 둘레를 따라간다 (<img> 상자가 그림 크기와 같다). */
  :where(.rc-frame) { position: relative; display: grid; place-items: center; aspect-ratio: var(--thumb-ratio); border-bottom: 1px solid var(--line); background: var(--paper); color: var(--teal); }
  :where(.rc-frame) .rc-thumb {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: auto; height: auto; max-width: calc(100% - 2 * var(--s4)); max-height: calc(100% - 2 * var(--s4));
    border: 1px solid var(--line); background: var(--card);
    /* 그림이 실리지 않은 동안 대체 글이 틀 위에 찍히지 않게 */
    color: transparent; font-size: 0;
  }

  :where(.rc-body) { display: grid; align-content: start; gap: var(--s1); padding: var(--s3) var(--s4) var(--s3); }
  :where(.rc-head) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s1) var(--s2); min-height: 2rem; }
  :where(.rc-label) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s1) var(--s2); margin: 0; font-size: var(--fs-xs); font-weight: 700; color: var(--teal); }
  :where(.rc-label) .type-icon { flex: none; }
  :where(.rc-title) { margin: 0; font-size: var(--fs-lg); font-weight: var(--fw-heading); line-height: var(--lh-tight); letter-spacing: -0.01em; text-wrap: balance; }
  :where(.rc-lesson) { margin: 0; font-size: var(--fs-sm); line-height: 1.45; }
  :where(.rc-lesson) a { color: var(--gray); text-decoration-color: var(--line); }
  :where(.rc-lesson) a:hover { color: var(--navy); }
  :where(.rc-format) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s1) var(--s2); margin: 0; font-size: var(--fs-sm); color: var(--gray); font-variant-numeric: tabular-nums; }

  /* 단추: 여는 단추 하나만 청록으로 채우고, 나머지는 테두리만. 누를 자리는 44px 이상 (R58). */
  :where(.rc-actions) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2); margin-top: auto; padding: 0 var(--s4) var(--s4); }
  :where(.rc-open, .rc-btn) {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--s1); min-height: var(--tap); padding: 0 var(--s3);
    border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--card); color: var(--navy);
    font: inherit; font-size: var(--fs-sm); font-weight: 700; line-height: 1.2; text-decoration: none; white-space: nowrap; cursor: pointer;
  }
  :where(.rc-open) { flex: 1 0 auto; padding-inline: var(--s4); border-color: var(--teal); background: var(--teal); color: var(--card); }
  :where(.rc-open):hover { border-color: var(--navy); background: var(--navy); color: var(--card); }
  :where(.rc-btn):hover { border-color: var(--teal); color: var(--teal); }

  /* 담기: 자료 종류 줄의 오른쪽 끝 (줄이 좁으면 다음 줄의 오른쪽). 보이는 크기는 32px 이고 누르는 자리는 위아래로 넓혀 44px 이다. */
  :where(.rc-collect) {
    position: relative; display: inline-flex; flex: none; align-items: center; margin-left: auto; gap: var(--s1); min-height: 2rem; padding: 0 var(--s3) 0 var(--s2);
    border: 1px solid var(--line); border-radius: var(--radius-pill); background: var(--card); color: var(--navy);
    font: inherit; font-size: var(--fs-xs); font-weight: 700; line-height: 1; white-space: nowrap; cursor: pointer;
  }
    /* 테두리 안쪽(30px)에서 위아래 7px 씩 넓혀 44px */
  :where(.rc-collect)::before { content: ''; position: absolute; inset: -7px -2px; }
  :where(.rc-collect):hover { border-color: var(--teal); color: var(--teal); }
  :where(.rc-collect[hidden]) { display: none; }
  :where(.rc-mark) { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; }
  :where(.rc-collect[aria-pressed='true']) { border-color: var(--teal); background: var(--teal); color: var(--card); }
  :where(.rc-collect[aria-pressed='true']) .rc-mark { fill: currentColor; }
  :where(.rc-collect-on) { display: none; }
  :where(.rc-collect[aria-pressed='true']) .rc-collect-on { display: inline; }
  :where(.rc-collect[aria-pressed='true']) .rc-collect-off { display: none; }

  /* QR 창: 화면 가운데에 뜨는 작은 상자. 바탕을 살짝 가려 상자에 눈이 가게 한다 (그림자 대신). */
  :where(.rc-pop) { width: min(20rem, calc(100vw - 2 * var(--s4))); padding: var(--s5); border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); color: var(--navy); text-align: center; }
  :where(.rc-pop)::backdrop { background: color-mix(in srgb, var(--navy) 40%, transparent); }
  :where(.rc-pop) .qr { display: block; width: 100%; max-width: 15rem; height: auto; margin: var(--s3) auto; }
  :where(.rc-pop-title) { margin: 0; font-size: var(--fs-lg); font-weight: var(--fw-heading); }
  :where(.rc-pop-sub) { margin: var(--s1) 0 0; font-size: var(--fs-sm); color: var(--gray); }
  :where(.rc-pop-url) { margin: 0 0 var(--s4); font-size: var(--fs-sm); color: var(--gray); }
  /* popover 를 모르는 브라우저: QR 단추를 숨기고 QR 과 주소를 카드 아래에 그대로 펼쳐 둔다 */
  @supports not selector(:popover-open) {
    .rc-qr, .rc-pop-close { display: none; }
    .rc-pop { grid-column: 1 / -1; width: auto; margin: 0 var(--s4) var(--s4); padding: var(--s4); }
  }

  /* 휴대폰: 미리보기를 왼쪽에 작게, 단추 줄은 카드 폭 전체 */
  @media (max-width: 599.98px) {
    :where(.rc) { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); grid-template-rows: auto 1fr auto; column-gap: var(--s3); }
    :where(.rc-frame) { grid-row: 1 / 3; align-self: start; margin: var(--s4) 0 0 var(--s4); border: 1px solid var(--line); border-radius: var(--radius-sm); }
    :where(.rc-frame) .rc-thumb { max-width: calc(100% - var(--s2)); max-height: calc(100% - var(--s2)); }
    :where(.rc-frame) .rc-icon { width: 28px; height: 28px; }
    /* 미리보기 틀에 이미 선 그림이 있다. 좁은 줄에서 자료 이름과 담기가 한 줄에 들게 이름 앞의 작은 그림은 뺀다 */
    :where(.rc-label) .type-icon { display: none; }
    :where(.rc-body) { grid-row: 1 / 3; padding: var(--s3) var(--s4) var(--s3) 0; }
    :where(.rc-title) { font-size: var(--fs-md); }
    :where(.rc-actions) { grid-column: 1 / -1; padding-top: var(--s1); }
  }
</style>
