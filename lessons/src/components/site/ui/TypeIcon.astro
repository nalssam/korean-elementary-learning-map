---
// 자료 종류 열 가지의 선 그림 (R53). 24 × 24 칸에 1.6 굵기의 선만 쓰고 색은 글자색(currentColor)을 따른다.
// 그림만으로 뜻을 전하지 않는다: 늘 곁에 자료 이름(ASSET_LABEL)이 있으므로 화면 읽기 프로그램에는 숨긴다(aria-hidden).
// 함께 쓰는 컴포넌트다 (계약. docs/CONTRACT.md 6절). 그림을 바꾸면 모든 페이지의 그림이 함께 바뀐다.
import type { AssetKind } from '#schema/lesson.ts';

interface Props {
  kind: AssetKind;
  /** 그리는 크기(px). 기본 20 */
  size?: number;
  class?: string;
}
const { kind, size = 20, class: cls } = Astro.props;
// 종류마다 선 그림 (path 의 d 값). 칸 둘레에 여백을 남겨 작게 그려도 선이 잘리지 않게 한다.
const PATHS: Record<AssetKind, string[]> = {
  // 수업 화면: 받침대 위의 화면
  slides: ['M4.5 4.5h15a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 15V6a1.5 1.5 0 0 1 1.5-1.5z', 'M12 16.5V20', 'M8 20h8'],
  // 학습지: 귀퉁이가 접힌 종이와 쓰는 줄
  worksheet: ['M6.5 3.5h7.5l4 4v12a1 1 0 0 1-1 1h-10.5a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1z', 'M14 3.5v4h4', 'M9 12h6', 'M9 15h6', 'M9 18h3.5'],
  // 확인 퀴즈: 물음표가 든 말풍선
  quiz: ['M5 4.5h14a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5h-7.5l-4 3.5v-3.5H5A1.5 1.5 0 0 1 3.5 15V6A1.5 1.5 0 0 1 5 4.5z', 'M9.8 8.6a2.2 2.2 0 1 1 3.1 2c-.6.3-.9.7-.9 1.3v.3', 'M12 14.1v.1'],
  // 웹 활동: 퍼즐 조각
  web_activity: ['M5 7h4a2 2 0 1 1 4 0h4v4a2 2 0 1 1 0 4v4H5z'],
  // 페이퍼크래프트: 종이를 접어 세운 세모 기둥
  papercraft: ['M3.5 19 9 7.5 14.5 19z', 'M9 7.5h8L20.5 18', 'M14.5 19h6'],
  // 카드: 겹친 두 장
  cards: ['M9 3.5h9a1.5 1.5 0 0 1 1.5 1.5v12a1.5 1.5 0 0 1-1.5 1.5H9A1.5 1.5 0 0 1 7.5 17V5A1.5 1.5 0 0 1 9 3.5z', 'M4.5 7v12A1.5 1.5 0 0 0 6 20.5h9'],
  // 컬러링 도안: 색연필
  coloring: ['M15.5 4.5l4 4L9 19H5v-4z', 'M13 7l4 4'],
  // 만들기 세트: 가위
  making_kit: ['M6.5 15a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z', 'M17.5 15a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z', 'M8.3 15.8 18 4', 'M15.7 15.8 6 4'],
  // 방탈출: 자물쇠
  escape: ['M6.5 10.5h11a1.5 1.5 0 0 1 1.5 1.5v7a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 19v-7a1.5 1.5 0 0 1 1.5-1.5z', 'M8 10.5V7.5a4 4 0 0 1 8 0v3', 'M12 14.5V17'],
  // 3D·가상 체험: 정육면체
  virtual3d: ['M12 3.5 19.5 7.5v9L12 20.5 4.5 16.5v-9z', 'M4.5 7.5 12 11.5l7.5-4', 'M12 11.5v9'],
};
---
<svg class:list={['type-icon', cls]} data-kind={kind} viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false"
  fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {PATHS[kind].map((d) => <path d={d} />)}
</svg>
