---
// 자료 유형별·업데이트·제작 현황·내 자료함의 머리: 청록 머리말(Kicker), 큰 제목(ExtraBold), 한 줄 설명 (R53).
// 소개·이용 조건 같은 다른 사이트 페이지의 머리와 같은 크기·간격으로 맞췄다. 설명은 slot 으로 받는다.
//   <CatHead kicker="모아 보기" title="자료 유형별">설명</CatHead>
import Kicker from '../ui/Kicker.astro';

interface Props {
  kicker: string;
  title: string;
}
const { kicker, title } = Astro.props;
---
<header class="cat-head">
  <Kicker>{kicker}</Kicker>
  <h1 class="cat-title">{title}</h1>
  {Astro.slots.has('default') && <p class="cat-lead"><slot /></p>}
</header>
