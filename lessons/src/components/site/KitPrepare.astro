---
// 준비물: 학습지, 흐름에서 쓰는 인쇄물마다 한 줄, 흐름에서 쓰는 만들기 세트, 명세의 prepare (docs/CONTRACT.md 5절).
// prepare 가운데 인쇄물 줄과 같은 것을 가리키는 항목은 따로 적지 않고 그 줄에 합친다 (6절. printRows 가 나눈다).
// 흐름에서 쓰지 않는 자료는 여기에 넣지 않고 '더 해 볼 자료'(KitMore)에 둔다.
import type { Lesson } from '#schema/lesson.ts';
import { printRows, usedInFlow } from './data.ts';
import MakingKitItem from './MakingKitItem.astro';
import PrintRowItem from './PrintRowItem.astro';

interface Props { lesson: Lesson }
const { lesson } = Astro.props;
const { prepare, extra } = printRows(lesson);
const kitInFlow = lesson.assets.making_kit.state === 'ready' && usedInFlow(lesson).has('making_kit');
---
<section class="sec" aria-labelledby="prepare-title">
  <h2 class="sec-title" id="prepare-title">준비물</h2>
  <ul class="mats">
    {prepare.map((row) => <PrintRowItem row={row} />)}
    {kitInFlow && <MakingKitItem lesson={lesson} />}
    {extra.map((p) => (
      <li class="mat">
        <div class="mat-main">
          <p class="mat-name"><span class="mat-title">{p.item}</span></p>
          {p.qty && <p class="mat-line">{p.qty}</p>}
        </div>
      </li>
    ))}
  </ul>
</section>
