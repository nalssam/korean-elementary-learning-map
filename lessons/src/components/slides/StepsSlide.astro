---
// 차례가 있는 단계 2~5개. 그림이 하나라도 있으면 가로로 늘어놓고, 없으면 위에서 아래로 늘어놓는다.
import Media from '#src/components/Media.astro';
import type { SlideProps } from './types.ts';

type Props = SlideProps<'steps'>;
const { lesson, slide } = Astro.props;
const across = slide.steps.some((s) => s.media);
---
<div class="sl-steps">
  <h2 class="sl-title">{slide.title}</h2>
  <ol class:list={['sl-steps-list', across ? 'is-across' : 'is-down']} style={`--n: ${slide.steps.length}`}>
    {slide.steps.map((s) => (
      <li class="sl-step">
        <span class="sl-chip">{s.label}</span>
        {across && (s.media ? <Media lesson={lesson} id={s.media} caption={false} class="sl-media" /> : <span class="sl-media-gap" />)}
        <span class="sl-step-text">{s.text}</span>
      </li>
    ))}
  </ol>
</div>
