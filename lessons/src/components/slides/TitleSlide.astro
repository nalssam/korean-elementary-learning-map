---
// 표지. 1번 장에는 차시표 값(단원·차시·교과서 쪽)을 찍는다. AI 사용 표시·초안 표시는 모든 장과 같이 바닥글 줄에 있다 (R55, Slide.astro).
// 두 차시 묶음이 둘째 차시 앞에 둔 표지는 제목과 부제만 찍는다. 표지에는 장 번호가 없다.
import { keepParticle } from '#lib/site.ts';
import { coverText } from './cover.ts';
import type { SlideProps } from './types.ts';

type Props = SlideProps<'title'>;
const { lesson, slide, no } = Astro.props;
const first = no === 1;
const c = coverText(lesson);
---
<div class="sl-cover">
  <div class="sl-cover-main">
    <p class="sl-kicker">{c.kicker}</p>
    <h2 class="sl-cover-title">{keepParticle(slide.title)}</h2>
    {slide.subtitle && <p class="sl-cover-sub">{keepParticle(slide.subtitle)}</p>}
  </div>
  {first && (
    <div class="sl-cover-foot">
      <p class="sl-cover-meta">{c.meta}</p>
    </div>
  )}
</div>
