---
// 표지. 1번 장에는 차시표 값과 footerNotice(lesson)(AI 사용 표시·초안 표시)를 찍는다 (docs/CONTRACT.md 6·8절).
// 두 차시 묶음이 둘째 차시 앞에 둔 표지는 제목과 부제만 찍는다.
import { coverText } from './cover.ts';
import type { SlideProps } from './types.ts';

type Props = SlideProps<'title'>;
const { lesson, slide, no } = Astro.props;
const first = no === 1;
const c = coverText(lesson);
---
<div class="sl-cover">
  <div class="sl-cover-main">
    <p class="sl-kicker">{c.kicker}</p>
    <h2 class="sl-cover-title">{slide.title}</h2>
    {slide.subtitle && <p class="sl-cover-sub">{slide.subtitle}</p>}
  </div>
  {first && (
    <div class="sl-cover-foot">
      <p class="sl-cover-meta">{c.meta}</p>
      <p class="sl-notice">{c.notice}</p>
    </div>
  )}
</div>
