---
// 시험용 쪽: 함께 쓰는 화면 부품(src/components/site/ui/)을 모두 그려 본다 (docs/CONTRACT.md 6절).
// tests/contract/ui.test.ts 가 HTML 을 읽고, Chromium 으로 담기·QR 창·좁은 화면을 눌러 본다. 격자는 부품이 아니라 부르는 페이지가 정한다.
import Base from '#src/layouts/Base.astro';
import { catalog } from '#lib/content.ts';
import { KIND_ORDER } from '#lib/site.ts';
import Band from '#src/components/site/ui/Band.astro';
import Kicker from '#src/components/site/ui/Kicker.astro';
import ResourceCard from '#src/components/site/ui/ResourceCard.astro';
import StatusChip from '#src/components/site/ui/StatusChip.astro';
import TypeIcon from '#src/components/site/ui/TypeIcon.astro';

const items = catalog();
const STATES = ['published', 'draft', 'planned', 'new', 'fix', 'notice'] as const;
---
<Base title="시험용 화면 부품" kind="site">
  <main class="ui-page">
    <p id="badge">내 자료함 <span data-collect-count>0</span></p>
    <Kicker>최근 올라온 자료</Kicker>
    <Kicker no={2} id="numbered">전개</Kicker>
    <h1>시험용 화면 부품</h1>
    <p id="chips">{STATES.map((s) => <StatusChip state={s} />)} <StatusChip state="draft" label="초안 5차시" /></p>
    <p id="icons">{KIND_ORDER.map((k) => <span class="icon-cell"><TypeIcon kind={k} size={32} /></span>)}</p>
    <ul class="ui-grid" id="cards">{items.map((item) => <li><ResourceCard item={item} /></li>)}</ul>
    <h2>여러 차시를 늘어놓을 때</h2>
    <ul class="ui-grid" id="with-lesson">{items.slice(0, 3).map((item) => <li><ResourceCard item={item} withLesson level={4} uid="b" /></li>)}</ul>
    <Band>사실마다 공개 출처를 붙이고, <strong>교사가 승인한 차시만</strong> 공개합니다.</Band>
  </main>
</Base>

<style>
  .ui-page { max-width: 1040px; margin: 0 auto; padding: 32px 16px; }
  .ui-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 16px; margin: 16px 0 32px; padding: 0; list-style: none; }
  #icons { display: flex; flex-wrap: wrap; gap: 12px; color: var(--teal); }
  .icon-cell { display: inline-grid; place-items: center; width: 48px; height: 48px; border: 1px solid var(--line); border-radius: 8px; background: var(--card); }
  #chips { display: flex; flex-wrap: wrap; gap: 8px; }
</style>
