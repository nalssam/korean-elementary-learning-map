{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src", "lib", "schema", "checks", "scripts", "generators", "tests"],
  "exclude": ["dist", "node_modules", ".cache"]
}
