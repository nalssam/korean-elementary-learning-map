{
  "name": "korean-elementary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "초등 사회 3~6학년 전 차시 수업 자료를 차시 명세 하나에서 만들어 내는 오픈소스 사이트",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#lib/*": "./lib/*",
    "#schema/*": "./schema/*",
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepare": "git config core.hooksPath || git config core.hooksPath lessons/.githooks || exit 0",
    "dev": "astro dev",
    "check": "node checks/run.mjs",
    "check:originality": "node checks/originality.mjs",
    "store:add": "node scripts/store-add.mjs",
    "test": "node --test",
    "typecheck": "astro check && tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:site": "astro build",
    "sign": "node scripts/sign.mjs",
    "new": "node scripts/new.mjs",
    "factsheet": "node scripts/factsheet.mjs"
  },
  "dependencies": {
    "astro": "^7.4.13",
    "pretendard": "^1.3.9",
    "qrcode": "^1.5.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "pagefind": "^1.6.0",
    "pdfjs-dist": "^6.5.438",
    "playwright": "1.63.0",
    "typescript": "^6.0.3"
  }
}
